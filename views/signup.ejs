<!DOCTYPE html>
<html>
<head>
  <title>Bowling Signup</title>
</head>
<body>
  <h1>Sign Up</h1>
  <form action="/signup" method="POST">
    <label>Username:</label><input name="username" required><br>
    <label>Password:</label><input type="password" name="password" required><br>
    <label>Name:</label><input name="name" required><br>
    <label>Average:</label><input type="number" name="average" required><br>
    <label>Lane Number:</label><input type="number" name="lane" required><br>
    <button type="submit">Sign Up</button>
  </form>
  <a href="/login">Login</a>
</body>
</html>
