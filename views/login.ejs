<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Bowling Brackets</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="auth-container">
    <div class="card">
      <div class="card-header">
        <div class="icon">🎳</div>
        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to your bowling account</p>
      </div>
      
      <form action="/login" method="post">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Enter your name" required>
        </div>
        
        <div class="form-group">
          <label for="lane">Lane Number</label>
          <input type="number" id="lane" name="lane" class="form-control" placeholder="Enter your lane" min="1" max="100" required>
        </div>
        
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
        </div>
        
        <button type="submit" class="btn btn-primary">Sign In</button>
      </form>
      
      <p class="auth-link">
        New to Bowling Brackets? <a href="/register">Create an account</a>
      </p>
    </div>
  </div>
</body>
</html>
