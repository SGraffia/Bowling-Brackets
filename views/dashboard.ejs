<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | Bowling Brackets</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard">
  <header class="dashboard-header">
    <h1>🎳 Bowling Brackets</h1>
    <div class="user-info">
      <span class="user-badge">
        <%= user.isAdmin ? '🛡️ Admin' : '🎳 Bowler' %> | Lane <%= user.lane %>
      </span>
      <span class="user-badge"><%= user.name %></span>
      <a href="/logout" class="logout-btn">Sign Out</a>
    </div>
  </header>

  <main class="dashboard-content">
    <% if(user.approved){ %>
      <div class="status-badge approved">
        ✓ Your buy-in is approved — You're in the brackets!
      </div>
    <% } else { %>
      <div class="status-badge pending">
        ⏳ Waiting for admin approval
      </div>
    <% } %>

    <section>
      <div class="section-header">
        <span class="icon">🏆</span>
        <h2>Active Brackets</h2>
      </div>

      <% if(brackets.length > 0) { %>
        <div class="brackets-grid">
          <% brackets.forEach(b => { %>
            <div class="bracket-card">
              <div class="bracket-header">
                <h3><%= b.id.replace('bracket-', 'Bracket #') %></h3>
                <span class="bracket-status"><%= b.status %></span>
              </div>
              <div class="bracket-body">
                <div class="prize-pool">
                  <div class="prize-item">
                    <div class="label">Total Pool</div>
                    <div class="amount">$<%= b.prizePool.total %></div>
                  </div>
                  <div class="prize-item">
                    <div class="label">1st Place</div>
                    <div class="amount gold">$<%= b.prizePool.firstPlace %></div>
                  </div>
                  <div class="prize-item">
                    <div class="label">2nd Place</div>
                    <div class="amount silver">$<%= b.prizePool.secondPlace %></div>
                  </div>
                </div>
                
                <ul class="bowlers-list">
                  <% b.bowlers.forEach(bid => { 
                    const bowler = data.registrations.find(r => r.id === bid);
                    const isPlaceholder = bid.startsWith('admin-placeholder');
                  %>
                    <li class="bowler-item">
                      <% if(isPlaceholder) { %>
                        <div class="bowler-avatar placeholder">?</div>
                        <span class="bowler-name placeholder">Open Slot</span>
                      <% } else if(bowler) { %>
                        <div class="bowler-avatar"><%= bowler.name.charAt(0).toUpperCase() %></div>
                        <span class="bowler-name"><%= bowler.name %></span>
                      <% } else { %>
                        <div class="bowler-avatar placeholder">?</div>
                        <span class="bowler-name placeholder">Unknown</span>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <p>No brackets available yet. Check back soon!</p>
        </div>
      <% } %>
    </section>

    <% if(user.isAdmin){ %>
      <section class="admin-section">
        <div class="section-header">
          <span class="icon">📋</span>
          <h2>Pending Approvals</h2>
        </div>
        
        <% const pendingUsers = data.registrations.filter(r => !r.approved); %>
        <% if(pendingUsers.length > 0) { %>
          <div class="approval-list">
            <% pendingUsers.forEach(u => { %>
              <div class="approval-item">
                <div class="approval-info">
                  <div class="approval-avatar"><%= u.name.charAt(0).toUpperCase() %></div>
                  <div class="approval-details">
                    <h4><%= u.name %></h4>
                    <span>Lane <%= u.lane %> • Average: <%= u.average %></span>
                  </div>
                </div>
                <form action="/admin/approve/<%= u.id %>" method="post">
                  <button type="submit" class="btn btn-success">✓ Approve Buy-In</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <p>No pending approvals at this time.</p>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>
</body>
</html>
