<h2>Welcome, <%= user.name %> | Lane: <%= user.lane %></h2>

<% if(user.approved){ %>
  <p>Your buy-in is approved. You are in the brackets.</p>
<% } else { %>
  <p>Waiting for admin approval.</p>
<% } %>

<h3>Brackets:</h3>
<ul>
  <% brackets.forEach(b => { %>
    <li><strong><%= b.id %></strong> - Prize Pool: $<%= b.prizePool.total %> 
      (1st: $<%= b.prizePool.firstPlace %>, 2nd: $<%= b.prizePool.secondPlace %>)<br/>
      Bowlers: 
      <% b.bowlers.forEach(bid => { %>
        <%= data.registrations.find(r => r.id === bid)?.name || bid %> 
      <% }) %>
    </li>
  <% }) %>
</ul>

<% if(user.isAdmin){ %>
  <h3>Admin Approvals:</h3>
  <% data.registrations.filter(r => !r.approved).forEach(u => { %>
    <form action="/admin/approve/<%= u.id %>" method="post">
      <%= u.name %> | <%= u.lane %>
      <button type="submit">Approve Buy-In</button>
    </form>
  <% }) %>
<% } %>
