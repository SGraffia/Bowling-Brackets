<h1>Admin Brackets</h1>
<% brackets.forEach(b => { %>
  <h2>Week <%= b.week %> (Buy-in: $<%= b.buyIn %>)</h2>
  <p>Prize Pool: $<%= b.prizes.totalPrize %> | 1st: $<%= b.prizes.firstPlace %> | 2nd: $<%= b.prizes.secondPlace %></p>

  <h3>Pending Approvals</h3>
  <ul>
  <% b.bowlers.forEach(bid=>{
       if(!b.approvedBowlers.includes(bid)){
         const br = registrations.find(r=>r.id===bid); %>
         <li><%= br.name %> 
           <button onclick="approve('<%= b.id %>','<%= br.id %>')">Approve</button>
         </li>
  <% }}) %>
  </ul>

  <h3>Approved Bowlers</h3>
  <ul>
    <% b.approvedBowlers.forEach(bid=>{
      const br = registrations.find(r=>r.id===bid); %>
      <li><%= br.name %></li>
    <% }) %>
  </ul>

  <% if(b.status==="open") { %>
    <a href="/bracket/<%= b.id %>/close">Close Bracket & Generate Results</a>
  <% } else { %>
    <p>Bracket Closed</p>
  <% } %>
<% }) %>

<script>
function approve(bracketId, bowlerId){
  fetch('/admin/bracket/approve',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({bracketId,bowlerId})
  }).then(r=>r.json()).then(()=>location.reload());
}
</script>
